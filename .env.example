# Copy this file to .env.local for local development. Never commit real secrets.

# --- Core -------------------------------------------------------------------
# Where the SQLite database lives. Defaults to var/solarekta.db.
# DATABASE_PATH=./var/solarekta.db

# Private upload storage (outside the web root). Defaults to var/uploads.
# UPLOAD_DIR=./var/uploads

# --- Optional AI assist ------------------------------------------------------
# The product works fully with AI disabled: bills can be entered manually and
# assessments use only the deterministic engine. To enable bill extraction and
# plain-language explanations (English/Filipino), quote summaries and the
# estimate Q&A, set:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...          # server-side only; never exposed to the browser
# OPENAI_MODEL=gpt-4o-mini       # this is a paid API: usage is billed to your key
# Optional limits:
# AI_TIMEOUT_MS=20000            # per attempt; one retry on timeouts/429/5xx
# AI_DAILY_LIMIT=                # per user, per feature, per 24h (defaults 10–30)
# Per-feature overrides, e.g. AI_DAILY_LIMIT_ADVISOR_EXTRACT=40, AI_DAILY_LIMIT_ADVISOR_EXPLAIN=40,
# AI_DAILY_LIMIT_QUOTE_EXTRACTION=8 (quotation PDF/photo reading is the most expensive call).

# --- Ask Solar AI (price advisor) -----------------------------------------------
# Works without AI: prices, matching, capacity and compatibility checks are deterministic.
# With AI on, signed-in users also get model-assisted question parsing, a validated summary
# and automatic quotation reading. Guests never trigger AI calls.
# ADVISOR_DAILY_QUESTIONS=60        # per signed-in user per 24h
# ADVISOR_GUEST_DAILY_QUESTIONS=15  # per guest browser per 24h (plus 12/min per IP)
# Sample (demo) supplier listings are used only in development. Set "on" for a local demo
# run with `next start`; leave unset (or "off") in production.
# ADVISOR_SAMPLE_DATA=off

# Optional external price feed (the "approved web-search integration" slot). Off unless set.
# Must return JSON { "records": [...] } with source URL (https), supplier, PHP price, price
# basis and date checked per record; incomplete or stale records are dropped.
# PRICE_FEED_URL=https://...
# PRICE_FEED_TOKEN=                 # sent as a Bearer token, server-side only
# PRICE_FEED_MAX_AGE_DAYS=30
# PRICE_FEED_CACHE_MINUTES=360
# PRICE_FEED_TIMEOUT_MS=8000

# --- Site surveys (ocular visits) ------------------------------------------------
# Media is stored privately under UPLOAD_DIR/surveys/<survey-id>/ and served only through
# authorised routes. Defaults shown; all optional.
# SURVEY_MAX_PHOTO_MB=25
# SURVEY_MAX_DOCUMENT_MB=25
# SURVEY_MAX_VIDEO_MB=500
# SURVEY_MAX_VIDEO_SECONDS=600       # read from MP4/MOV files by the server; device-reported for WEBM
# SURVEY_MAX_EVIDENCE=200            # files per survey
# SURVEY_REQUIRED_EVIDENCE=site_frontage:1,roof_overview:1   # or "none"
# SURVEY_GEOFENCE_METERS=300         # check-in vs site pin comparison
# SURVEY_MAX_GPS_ACCURACY_METERS=100 # worse accuracy is flagged as "too imprecise"
# SURVEY_REQUIRE_CHECK_IN=on         # "off" stops flagging surveys without "Start site visit"
# AI_DAILY_LIMIT_SURVEY_ASSIST=15

# --- Deployment notes --------------------------------------------------------
# This MVP uses SQLite and a single Node process. For a multi-instance pilot,
# move to PostgreSQL + object storage + a shared rate limiter first.
# NODE_ENV=production
