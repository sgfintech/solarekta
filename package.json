    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
